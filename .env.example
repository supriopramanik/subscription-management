# Server only. Never prefix these values with VITE_.
MONGODB_URI=mongodb://localhost:27017/complaiance_subscriptions?replicaSet=rs0
PORT=4000
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Use the Cloudinary API environment variable (cloudinary://key:secret@cloud).
CLOUDINARY_URL=
# Existing CLOUDINARY_BACKUP_URL is also supported when it contains a cloudinary:// URL.
CLOUDINARY_FOLDER=complaiance-subscriptions
# Optional instead of CLOUDINARY_URL:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# In production, use HTTPS and leave COOKIE_SECURE=true.
COOKIE_SECURE=false
# Number of trusted reverse proxies; Coolify normally uses one.
TRUST_PROXY=1
